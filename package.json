{
  "name": "web-sdk-pp-rotated-detection",
  "version": "0.1.0",
  "description": "基于 PP-YOLOE-R 的浏览器旋转框检测 SDK",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenmohan123/web-sdk-PP-RotatedDetection.git"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inference.worker.js": "./dist/inference.worker.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1",
    "dev:local": "vite --config demo/vite.config.ts --mode dev-local --host 127.0.0.1",
    "dev:vanilla": "vite --config demo/vite.config.ts --mode vanilla --host 127.0.0.1 --port 4193",
    "dev:vanilla:local": "vite --config demo/vite.config.ts --mode vanilla-local --host 127.0.0.1 --port 4193",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck:demo": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --jsx react-jsx --resolveJsonModule --strict --skipLibCheck --lib ES2022,DOM,DOM.Iterable demo/src/main.tsx demo/src/App.tsx demo/vite.config.ts examples/vanilla/main.ts",
    "test:browser": "node tests/browser.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "0.468.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "yaml": "2.8.1"
  }
}
